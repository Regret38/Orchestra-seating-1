# Copy to .env.local for online mode. Never paste a secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Empty URL/key => demo (memory only). Set true to force demo.
VITE_DEMO_MODE=false
# GitHub Actions configures this automatically; local development uses /.
VITE_BASE_PATH=/
